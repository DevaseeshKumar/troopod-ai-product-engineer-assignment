<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg"><span class="st">★★★★★</span> <b>{{ section.settings.rating | default: "4.8" }}</b> {{ section.settings.rating_subtitle | default: "from 8,000+ reviews" }}</span>
      <span class="agg">Loved by <b>{{ section.settings.homes_count | default: "12 lakh+" }}</b> homes</span>
    </div>
  </div>

  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article class="glass-2 rcard" {{ block.shopify_attributes }}>
            <div class="st">{{ block.settings.rating | default: '★★★★★' }}</div>
            <h5>{{ block.settings.heading }}</h5>
            <p>{{ block.settings.quote }}</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>{{ block.settings.author }}</b>
              {% if block.settings.product_note != blank %}<span>&middot; {{ block.settings.product_note }}</span>{% endif %}
            </div>
          </article>
        {% endfor %}
        <!-- Duplicate loop for smooth continuous marquee -->
        {% for block in section.blocks %}
          <article class="glass-2 rcard" aria-hidden="true">
            <div class="st">{{ block.settings.rating | default: '★★★★★' }}</div>
            <h5>{{ block.settings.heading }}</h5>
            <p>{{ block.settings.quote }}</p>
            <div class="who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>{{ block.settings.author }}</b>
              {% if block.settings.product_note != blank %}<span>&middot; {{ block.settings.product_note }}</span>{% endif %}
            </div>
          </article>
        {% endfor %}
      {% else %}
        <!-- Fallback prototype reviews -->
        <article class="glass-2 rcard"><div class="st">★★★★★</div><h5>Works like a charm</h5><p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Anita</b><span>&middot; Laundry detergent</span></div></article>
        <article class="glass-2 rcard"><div class="st">★★★★★</div><h5>Best dishwash ever</h5><p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Priya</b><span>&middot; Dishwash gel</span></div></article>
        <article class="glass-2 rcard"><div class="st">★★★★★</div><h5>Great product, great packaging</h5><p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Sunita</b><span>&middot; Liquid handwash</span></div></article>
        <article class="glass-2 rcard"><div class="st">★★★★★</div><h5>Dog friendly</h5><p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Rohit S.</b><span>&middot; Floor cleaner</span></div></article>
        <article class="glass-2 rcard"><div class="st">★★★★★</div><h5>Sparkling taps again</h5><p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Verified buyer</b><span>&middot; Tap cleaner</span></div></article>

        <!-- Duplicated track for continuous marquee loop -->
        <article class="glass-2 rcard" aria-hidden="true"><div class="st">★★★★★</div><h5>Works like a charm</h5><p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Anita</b><span>&middot; Laundry detergent</span></div></article>
        <article class="glass-2 rcard" aria-hidden="true"><div class="st">★★★★★</div><h5>Best dishwash ever</h5><p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Priya</b><span>&middot; Dishwash gel</span></div></article>
        <article class="glass-2 rcard" aria-hidden="true"><div class="st">★★★★★</div><h5>Great product, great packaging</h5><p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Sunita</b><span>&middot; Liquid handwash</span></div></article>
        <article class="glass-2 rcard" aria-hidden="true"><div class="st">★★★★★</div><h5>Dog friendly</h5><p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Rohit S.</b><span>&middot; Floor cleaner</span></div></article>
        <article class="glass-2 rcard" aria-hidden="true"><div class="st">★★★★★</div><h5>Sparkling taps again</h5><p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p><div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Verified buyer</b><span>&middot; Tap cleaner</span></div></article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Band",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_subtitle",
      "label": "Rating Subtitle",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes Count",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "rating",
          "label": "Stars Rating",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_note",
          "label": "Product Tag/Note",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Band"
    }
  ]
}
{% endschema %}
