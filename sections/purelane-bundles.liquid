{% liquid
  assign bundles_description = section.settings.description | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.'
  assign bundles_description = bundles_description | replace: 'skin. One', 'skin.<br>One'
  assign bundles_description = bundles_description | replace: 'either way.', 'either&nbsp;way.'
%}

<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | default: 'Build your bundle' }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'One box. Every room.' }}</h2>
        <p class="lede bundle-description" style="margin:0 auto">{{ bundles_description }}</p>
      </div>
    </div>

    <div class="tiers">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign bundle_products = block.settings.products
            assign bundle_product = block.settings.bundle_product
            if bundle_products == blank and block.settings.product != blank
              assign bundle_products = block.settings.product
            endif

            assign bundle_count = 0
            assign bundle_total_price = 0
            assign bundle_total_compare = 0
            for product in bundle_products
              assign bundle_count = bundle_count | plus: 1
              assign bundle_total_price = bundle_total_price | plus: product.price
              assign product_compare = product.compare_at_price | default: product.price
              assign bundle_total_compare = bundle_total_compare | plus: product_compare
            endfor

            assign is_featured = block.settings.is_featured
            assign delay_class = ''
            if forloop.index == 2
              assign delay_class = 'rv-d2'
            elsif forloop.index == 3
              assign delay_class = 'rv-d3'
            endif

            if bundle_count > 0
              assign displayed_count = bundle_count
            else
              assign displayed_count = block.settings.qty | default: '2'
            endif
          %}
          <article class="glass tier {% if is_featured %}best{% endif %} rv {{ delay_class }}" {{ block.shopify_attributes }}>
            {% if block.settings.tag != blank %}
              <span class="tag">{{ block.settings.tag }}</span>
            {% endif %}

            <div class="tierpix{% if bundle_count > 3 %} five{% endif %}" aria-hidden="true">
              {% if bundle_products != blank %}
                {% for product in bundle_products limit: 5 %}
                  {% if product.featured_image != blank %}
                    {{ product.featured_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy', class: 'pimg' }}
                  {% else %}
                    <span class="product-media-fallback product-media-fallback--small"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10l1 4v13H6V7l1-4Z"/></svg></span>
                  {% endif %}
                {% endfor %}
              {% else %}
                <span class="pimg p-combo2"></span>
              {% endif %}
            </div>

            <div class="qty">{{ displayed_count }}<small>{{ block.settings.qty_unit | default: 'Products' }}</small></div>
            <div class="price">
              {% if bundle_product != blank %}{{ bundle_product.price | money }}{% elsif bundle_total_price > 0 %}{{ bundle_total_price | money }}{% else %}{{ block.settings.price | default: '₹349' }}{% endif %}
              {% if bundle_product.compare_at_price > bundle_product.price %}<s>{{ bundle_product.compare_at_price | money }}</s>{% elsif bundle_total_compare > bundle_total_price %}<s>{{ bundle_total_compare | money }}</s>{% endif %}
            </div>
            {% if block.settings.unit_price != blank %}
              <p class="body-s" style="font-size:12px">{{ block.settings.unit_price }}</p>
            {% endif %}

            <ul>
              {% if block.settings.feature_1 != blank %}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 }}</li>
              {% endif %}
              {% if block.settings.feature_2 != blank %}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
              {% endif %}
              {% if block.settings.feature_3 != blank %}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
              {% endif %}
            </ul>

            {% if bundle_product != blank %}
              <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ bundle_product.selected_or_first_available_variant.id }}">
                <button type="submit" class="btn {% if is_featured %}btn-primary{% else %}btn-ghost{% endif %}">{{ block.settings.button_label | default: 'Build this box' }}</button>
              </form>
            {% elsif bundle_products != blank %}
              <form method="post" action="{{ routes.cart_add_url }}">
                {% for product in bundle_products %}
                  {% if product.selected_or_first_available_variant != blank %}<input type="hidden" name="items[{{ forloop.index0 }}][id]" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}
                {% endfor %}
                <button type="submit" class="btn {% if is_featured %}btn-primary{% else %}btn-ghost{% endif %}">
                  {{ block.settings.button_label | default: 'Build this box' }}
                  {% if is_featured %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>{% endif %}
                </button>
              </form>
            {% else %}
              <a class="btn {% if is_featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">
                {{ block.settings.button_label | default: 'Build this box' }}
              {% if is_featured %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {% endif %}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        <!-- Fallback prototype tiers (100% match purelane-homepage.html) -->
        <article class="glass tier rv">
          <span class="tag">Starter</span><div class="tierpix" aria-hidden="true"><span class="pimg p-combo2" role="img" aria-label="Purelane tap cleaner and kitchen cleaner combo pack"></span></div>
          <div class="qty">2<small>Products</small></div>
          <div class="price">₹349 <s>₹598</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹174 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Pick any two products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>

        <article class="glass tier best rv rv-d2">
          <span class="tag">Most popular</span><div class="tierpix" aria-hidden="true"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span><span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel"></span></div>
          <div class="qty">3<small>Products</small></div>
          <div class="price">₹499 <s>₹897</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹166 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Pick any three products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Covers kitchen and laundry</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-primary" href="#shop">Build this box
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </article>

        <article class="glass tier rv rv-d3">
          <span class="tag">Whole home</span><div class="tierpix five" aria-hidden="true"><span class="pimg p-kitchen" role="img" aria-label="Purelane foaming kitchen cleaner"></span><span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover"></span><span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner"></span><span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner"></span><span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent"></span></div>
          <div class="qty">5<small>Products</small></div>
          <div class="price">₹799 <s>₹1495</s></div>
          <p class="body-s" style="font-size:12px">Flat ₹160 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Pick any five products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Every room in one order</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>
          <a class="btn btn-ghost" href="#shop">Build this box</a>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles Tiers",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        { "type": "product", "id": "bundle_product", "label": "Bundle product (recommended)" },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products in this bundle",
          "limit": 12
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tier Tag",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity Number",
          "default": "2"
        },
        {
          "type": "text",
          "id": "qty_unit",
          "label": "Quantity Label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "unit_price",
          "label": "Unit Price Subtitle",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Highlight as Best Value",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles Tiers"
    }
  ]
}
{% endschema %}
