{% liquid
  assign product_limit = section.settings.products_to_show | default: 8
  assign product_collection = section.settings.collection | default: collections['all']
%}

<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bestsellers' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'Loved by 30,000 homes' }}</h2>
      <div class="rule" aria-hidden="true"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
    </div>
    <div class="shelf">
      {% for product in product_collection.products limit: product_limit %}
        {% liquid
          assign delay_class = ''
          assign position = forloop.index0 | modulo: 4
          if position == 1
            assign delay_class = 'rv-d1'
          elsif position == 2
            assign delay_class = 'rv-d2'
          elsif position == 3
            assign delay_class = 'rv-d3'
          endif
        %}
        {% render 'purelane-product-card', product: product, animation_delay: delay_class, button_label: section.settings.button_label %}
      {% else %}
        <p class="body-s">{{ section.settings.empty_message | default: 'Add products to the selected collection to populate this shelf.' }}</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 1, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Add button label", "default": "Add to cart" },
    { "type": "text", "id": "empty_message", "label": "Empty collection message", "default": "Add products to the selected collection to populate this shelf." }
  ],
  "presets": [{ "name": "Purelane Shop Grid" }]
}
{% endschema %}
