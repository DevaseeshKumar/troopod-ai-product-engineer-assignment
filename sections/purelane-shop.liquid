{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}
