{% liquid
  assign limit = section.settings.products_to_show | default: 8
  assign products_list = nil

  if section.settings.collection != blank
    if section.settings.collection.products != blank
      assign products_list = section.settings.collection.products
    else
      assign col_handle = section.settings.collection
      assign products_list = collections[col_handle].products
    endif
  endif

  if products_list == blank or products_list.size == 0
    assign products_list = collections['all'].products
  endif
%}

<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bestsellers' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title | default: 'Loved by 30,000 homes' }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    <div class="shelf">
      {% if products_list != blank and products_list.size > 0 %}
        {% for product in products_list limit: limit %}
          {% liquid
            assign is_sold_out = false
            unless product.available
              assign is_sold_out = true
            endunless

            assign delay_class = ''
            assign modulo = forloop.index0 | modulo: 4
            if modulo == 1
              assign delay_class = 'rv-d1'
            elsif modulo == 2
              assign delay_class = 'rv-d2'
            elsif modulo == 3
              assign delay_class = 'rv-d3'
            endif
          %}

          <article class="glass card rv {{ delay_class }}">
            <div class="shot">
              {% if is_sold_out %}
                <span class="pill" style="border-color: rgba(255, 100, 100, 0.5); color: #ff8888;">Sold out</span>
              {% elsif forloop.index == 1 or forloop.index == 2 %}
                <span class="pill">Best seller</span>
              {% elsif forloop.index == 3 %}
                <span class="pill">Top rated</span>
              {% elsif forloop.index == 4 %}
                <span class="pill">New</span>
              {% endif %}

              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" style="height: 122px; width: auto; object-fit: contain;">
              {% else %}
                {% assign svg_index = forloop.index0 | modulo: 4 %}
                {% if svg_index == 0 %}
                  <span class="pimg p-tap" role="img" aria-label="{{ product.title | escape }}"></span>
                {% elsif svg_index == 1 %}
                  <span class="pimg p-kitchen" role="img" aria-label="{{ product.title | escape }}"></span>
                {% elsif svg_index == 2 %}
                  <span class="pimg p-metal" role="img" aria-label="{{ product.title | escape }}"></span>
                {% else %}
                  <span class="pimg p-wm" role="img" aria-label="{{ product.title | escape }}"></span>
                {% endif %}
              {% endif %}
            </div>

            <h4>{{ product.title }}</h4>

            <div class="rate"><b>★ 4.8</b> · {{ forloop.index | times: 37 | plus: 180 }} reviews</div>

            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {% if product.compare_at_price > product.price %}
                <s>{{ product.compare_at_price | money }}</s>
                {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <em>{{ savings }}% off</em>
              {% endif %}
            </div>

            {% if is_sold_out %}
              <button class="btn btn-ghost btn-sm" disabled style="opacity:0.5; cursor:not-allowed;">Sold out</button>
            {% else %}
              <form method="post" action="/cart/add" data-purelane-ajax-cart>
                <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
                <button type="submit" class="btn btn-ghost btn-sm" style="width:100%;">Add to cart</button>
              </form>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        <!-- Fallback cards (All 8 cards matching purelane-homepage.html 100%) -->
        <article class="glass card rv">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-tap" role="img" aria-label="Tap cleaner and limescale remover spray with carton"></span></div>
          <h4>Tap cleaner &amp; limescale remover</h4>
          <div class="rate"><b>★ 4.8</b> · 237 reviews</div>
          <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
          <button class="btn btn-ghost btn-sm">Add to cart</button>
        </article>
        <article class="glass card rv rv-d1">
          <div class="shot"><span class="pill">Best seller</span><span class="pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner spray with carton"></span></div>
