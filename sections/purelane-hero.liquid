{% liquid
  assign p1_setting = section.settings.product_1
  assign p2_setting = section.settings.product_2
  assign p3_setting = section.settings.product_3

  if p1_setting.featured_image != blank
    assign product_1 = p1_setting
  elsif p1_setting != blank
    assign product_1 = all_products[p1_setting]
  endif

  if p2_setting.featured_image != blank
    assign product_2 = p2_setting
  elsif p2_setting != blank
    assign product_2 = all_products[p2_setting]
  endif

  if p3_setting.featured_image != blank
    assign product_3 = p3_setting
  elsif p3_setting != blank
    assign product_3 = all_products[p3_setting]
  endif

  assign image_1 = product_1.featured_image
  assign image_2 = product_2.featured_image
  assign image_3 = product_3.featured_image

  assign hero_description = section.settings.description | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.'
  assign hero_description = hero_description | replace: 'made from plants.', 'made from<br>plants.'
  assign hero_description = hero_description | replace: 'the world outside it.', 'the world<br>outside it.'
%}

<section class="hero" data-scene="1" id="top" data-purelane-hero>
  <div class="hero-grid">

    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        </span>
        <span>Plant<br>powered</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
        </span>
        <span>Safe for<br>kids &amp; pets</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
        </span>
        <span>Zero harsh<br>chemicals</span>
      </div>
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.heading_line_1 | default: 'Clean' }}<br>
        {{ section.settings.heading_line_2 | default: 'That' }}<br>
        <span class="lime">{{ section.settings.heading_line_3 | default: 'Lasts' }}</span>
      </h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ hero_description }}</p>
      <div class="hero-cta rv rv-d3">
        <a class="btn btn-primary" href="{{ section.settings.primary_link | default: '#shop' }}">
          {{ section.settings.primary_label | default: 'Shop now' }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="{{ section.settings.secondary_link | default: '#how' }}">
          {{ section.settings.secondary_label | default: 'How it works' }}
        </a>
      </div>

      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          Plant powered
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          Kids &amp; pet safe
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
          Zero harsh chem
        </div>
      </div>
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        <div class="hslide hs1 on" data-n="1">
          {% if image_1 != blank %}{{ image_1 | image_url: width: 900 | image_tag: alt: product_1.title, loading: 'eager', widths: '360, 540, 720, 900', class: 'hp hp--photo a d1' }}{% else %}<span class="hp p-kbtl a d1" role="img" aria-label="Product image placeholder"></span>{% endif %}
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.offer_1_label | default: 'Single bottle' }}</span>
            <span class="val"><strong>{% if product_1 != blank %}{{ product_1.price | money }}{% else %}{{ section.settings.offer_1_price | default: '₹200' }}{% endif %}</strong>{% if product_1.compare_at_price > product_1.price %}<s>{{ product_1.compare_at_price | money }}</s>{% elsif section.settings.offer_1_compare != blank %}<s>{{ section.settings.offer_1_compare }}</s>{% endif %}</span>
            <span class="cut">{{ section.settings.offer_1_note | default: '33% off' }}</span>
          </div>
        </div>
        <div class="hslide hs2" data-n="2">
          {% if image_2 != blank %}{{ image_2 | image_url: width: 900 | image_tag: alt: product_2.title, loading: 'lazy', widths: '360, 540, 720, 900', class: 'hp hp--photo b d2' }}{% else %}<span class="hp p-kbtl b d2" role="img" aria-label="Product image placeholder"></span>{% endif %}
          {% if image_1 != blank %}{{ image_1 | image_url: width: 720 | image_tag: alt: product_1.title, loading: 'lazy', widths: '320, 480, 720', class: 'hp hp--photo a d1' }}{% else %}<span class="hp p-tbtl a d1" role="img" aria-label="Product image placeholder"></span>{% endif %}
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.offer_2_label | default: 'Any 2 products' }}</span>
            <span class="val"><strong>{{ section.settings.offer_2_price | default: '&#8377;349' }}</strong><s>{{ section.settings.offer_2_compare | default: '&#8377;598' }}</s></span>
            <span class="cut">{{ section.settings.offer_2_note | default: 'Save &#8377;249' }}</span>
          </div>
        </div>
        <div class="hslide hs3" data-n="3">
          {% if image_1 != blank %}{{ image_1 | image_url: width: 720 | image_tag: alt: product_1.title, loading: 'lazy', widths: '320, 480, 720', class: 'hp hp--photo a d1' }}{% else %}<span class="hp p-tbtl a d1" role="img" aria-label="Product image placeholder"></span>{% endif %}
          {% if image_3 != blank %}{{ image_3 | image_url: width: 720 | image_tag: alt: product_3.title, loading: 'lazy', widths: '320, 480, 720', class: 'hp hp--photo b d2' }}{% else %}<span class="hp p-mbtl b d2" role="img" aria-label="Product image placeholder"></span>{% endif %}
          {% if image_2 != blank %}{{ image_2 | image_url: width: 900 | image_tag: alt: product_2.title, loading: 'lazy', widths: '360, 540, 720, 900', class: 'hp hp--photo c d3' }}{% else %}<span class="hp p-kbtl c d3" role="img" aria-label="Product image placeholder"></span>{% endif %}
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.offer_3_label | default: 'Any 3 products' }}</span>
            <span class="val"><strong>{{ section.settings.offer_3_price | default: '&#8377;499' }}</strong><s>{{ section.settings.offer_3_compare | default: '&#8377;897' }}</s></span>
            <span class="cut">{{ section.settings.offer_3_note | default: 'Save &#8377;398' }}</span>
          </div>
        </div>
      </div>
      <div class="hdots" id="hdots">
        <button type="button" class="on" aria-label="Show 1 product"></button>
        <button type="button" class="" aria-label="Show 2 products"></button>
        <button type="button" class="" aria-label="Show 3 products"></button>
      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    function initHeroRotator(root) {
      if (!root) return;
      const slides = root.querySelectorAll('.hslide');
      const dots = root.querySelectorAll('.hdots button');
      if (!slides.length || !dots.length) return;

      let current = 0;
      let timer = null;

      function goTo(index) {
        slides.forEach((s, i) => s.classList.toggle('on', i === index));
        dots.forEach((d, i) => d.classList.toggle('on', i === index));
        current = index;
      }

      function next() {
        goTo((current + 1) % slides.length);
      }

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          goTo(idx);
          resetAuto();
        });
      });

      function startAuto() {
        if (!timer) timer = setInterval(next, 4500);
      }

      function resetAuto() {
        if (timer) clearInterval(timer);
        timer = setInterval(next, 4500);
      }

      startAuto();
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-purelane-hero]').forEach(initHeroRotator);
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        const hero = e.target.querySelector('[data-purelane-hero]');
        if (hero) initHeroRotator(hero);
      });
    }
  })();
</script>

